{% extends 'base.html.twig' %}

{% block title %}Contact William{% endblock %}

{% block body %}
    <div class="layout-maxed contact">
        <div class="contact-card flex my-30">
            <div class="avatar-part fade-in-1">
                <h2>Contact</h2>
                <img src="{{params.profilePhoto}}" alt="Profile photo">
            </div>
            <div class="contact-form fade-in-2">
                <h1>Let's Collaborate !</h1>
                <p>Lorem ipsum dolor sit, amet consectetur adipisicing elit. Incidunt, magnam! Vero necessitatibus ullam corrupti ipsam debitis, excepturi eaque esse. Placeat sequi rem porro commodi earum quaerat ipsam quisquam quo dolor?</p>
                {{ include('contact/_form.html.twig') }}
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success mt-10">
                        {{ message }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}