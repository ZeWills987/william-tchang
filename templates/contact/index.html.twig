{% extends 'base.html.twig' %}

{% block title %}Contact William{% endblock %}

{% block body %}
    <div class="layout-maxed home">
        <div class="about-me my-70">
            <div class="flex flex-col justify-between">
                <h2 data-aos="fade-up" class="title-section">ABOUT ME</h2>
                <img data-aos="fade-up" src="{{ asset('image/me.jpg') }}" alt="" class="avatar fade-in-scroll">
            </div>
            <h3 data-aos="fade-up" class="fade-in-scroll">
                Hi I’m William and I am passionate about everything that has to do with App Developpement and Web. I enjoy working with agencies and enthusiastic people who want to 
            </h3>
        </div>


        <div id="project" class="projects mb-70">
            <div class="top">
                <h3 data-aos="fade-up" class="title-section-white">WHAT I'M DOING</h3>
                <h2 data-aos="fade-up">WEB DEVELOPEMENT</h2>
                <h2 data-aos="fade-up">FRONT-END</h2>
                <h2 data-aos="fade-up">BACK-END</h2>
                <h2 data-aos="fade-up">UI/UX Design</h2>
            </div>
            <div class="swiper-projects mt-10 md:mt-30">
                <div class="flex justify-between">
                    <h3 data-aos="fade-up" class="title-section-white m-0">SELECTED PROJECT</h3>
                    <div data-aos="fade-up" class="next-prev">
                        <div class="swiper-button-prev">
                        </div>
                        <div class="swiper-button-next">
                        </div>
                    </div>
                </div>
                <div class="swiper-wrapper">
                    {% for project in projects %}
                        <div data-aos="fade-up" class="swiper-slide">
                            <div class="card-project">
                                <img src="{{ asset(project.image) }}" alt="">
                                <div class="content">
                                    <h3 class="title-section-white">{{loop.index}}/{{projects|length}}</h3>
                                    <div class="bottom">
                                        <div class="content-text">
                                            <div class="flex flex-col gap-10">
                                                <h3 class="item">{{project.title}} ({{project.date|date('Y')}})</h3>
                                                <p>{{project.extract}}</p>
                                            </div>
                                        </div>
                                        <a href="{{project.link}}" class="btn-link">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </div>
{% endblock %}