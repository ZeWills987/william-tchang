    {% extends 'base.html.twig' %}

    {% block title %}Work William{% endblock %}

    {% block body %}
        <div class="layout-maxed work-page">
            <h1 data-aos-easing="ease" data-aos-duration="400" data-aos-delay="50">My Works</h1>

            {{dump(projects)}}
            <div class="works">
                {% for project in projects %}
                    <div class="work-card">
                        <a href="">
                            <img src="{{ asset(project.image) }}" alt="{{ project.title }}">
                            <div class="content">
                                <div class="top">
                                    <p> {{ loop.index }}/{{ projects|length }}</p>
                                </div>
                                <div class="bottom">
                                    <div class="col">
                                        <h3>{{ project.title }}</h3>
                                        <p>{{ project.description }}</p>
                                    </div>
                                    <div class="col">
                                        <h3>Skills</h3>
                                        <ul>
                                            {% for skill in project.skills %}
                                                <li>{{ skill }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div> 
        </div>
    {% endblock %}