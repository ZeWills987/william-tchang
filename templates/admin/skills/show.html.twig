{% extends 'base_admin.html.twig' %}

{% block title %}Skills{% endblock %}

{% block body %}
    <div class="layout-maxed project-page show">
        <div class="bg-dark px-20 py-30 mb-70 all-projects">
            <h1>Skills</h1>

            <table class="table">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ skill.id }}</td>
                    </tr>
                    <tr>
                        <th>Name</th>
                        <td>{{ skill.name }}</td>
                    </tr>
                    <tr>
                        <th>Type</th>
                        <td>{{ skill.type }}</td>
                    </tr>
                    <tr>
                        <th>Image</th>
                        <td><img src="{{ asset(skill.image) }}" alt="Image de {{ skill.name }}" class="img-fluid"></td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ skill.description }}</td>
                    </tr>
                    <tr>
                        <th>Ordre</th>
                        <td>{{ skill.ordered }}</td>
                    </tr>

                </tbody>
            </table>

            <a class="btn" href="{{ path('app_skills_index') }}">back to list</a>

            <a class="btn-back" href="{{ path('app_skills_edit', {'id': skill.id}) }}">edit</a>

            {{ include('admin/skills/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
