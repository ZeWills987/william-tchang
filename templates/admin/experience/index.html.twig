{% extends 'base_admin.html.twig' %}

{% block title %}Experience index{% endblock %}

{% block body %}
    <div class="layout-maxed project-page">
        <div class="bg-dark px-20 py-30 mb-70 all-projects">
            <h1>Experience index</h1>

            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Job</th>
                        <th>Company</th>
                        <th>Date_start</th>
                        <th>Date_end</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for experience in experiences %}
                    <tr>
                        <td>{{ experience.id }}</td>
                        <td>{{ experience.job }}</td>
                        <td>{{ experience.company }}</td>
                        <td>{{ experience.dateStart ? experience.dateStart|date('Y-m-d') : '' }}</td>
                        <td>{{ experience.dateEnd ? experience.dateEnd|date('Y-m-d') : '' }}</td>
                        <td>
                            <a href="{{ path('app_experience_show', {'id': experience.id}) }}">show</a>
                            <a href="{{ path('app_experience_edit', {'id': experience.id}) }}">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <a href="{{ path('app_experience_new') }}">Create new</a>
         </div>
    </div>
{% endblock %}
