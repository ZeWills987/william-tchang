{% extends 'base.html.twig' %}

{% block title %}Experience{% endblock %}

{% block body %}
    <div class="layout-maxed experience-page show">
        <div class="bg-dark px-20 py-30 mb-70 all-experiences">
            <h1>Experience</h1>

            <table class="table">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ experience.id }}</td>
                    </tr>
                    <tr>
                        <th>Job</th>
                        <td>{{ experience.job }}</td>
                    </tr>
                    <tr>
                        <th>Company</th>
                        <td>{{ experience.company }}</td>
                    </tr>
                    <tr>
                        <th>Date_start</th>
                        <td>{{ experience.dateStart ? experience.dateStart|date('Y-m-d') : '' }}</td>
                    </tr>
                    <tr>
                        <th>Date_end</th>
                        <td>{{ experience.dateEnd ? experience.dateEnd|date('Y-m-d') : '' }}</td>
                    </tr>
                </tbody>
            </table>

            <a href="{{ path('app_experience_index') }}">back to list</a>

            <a href="{{ path('app_experience_edit', {'id': experience.id}) }}">edit</a>

            {{ include('experience/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
